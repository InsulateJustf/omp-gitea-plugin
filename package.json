{
  "name": "omp-gitea-issue-read",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Read Gitea issues and pull request lists, details, and raw diffs through the native read tool in OMP agent sessions",
  "files": [
    "index.js",
    "diff.js"
  ],
  "omp": {
    "extensions": ["./index.js"]
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm pack --pack-destination dist",
    "build:release": "node scripts/build-release.js",
    "verify:release": "node scripts/verify-release.js",
    "test": "node --test"
  },
  "dependencies": {
    "lossless-json": "4.3.1"
  }
}
